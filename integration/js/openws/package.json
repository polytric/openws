{
    "name": "@polytric/openws",
    "version": "0.0.10",
    "description": "Polytric OpenWS Runtime",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./class": {
            "types": "./dist/class/index.d.ts",
            "import": "./dist/class/index.js",
            "require": "./dist/class/index.cjs"
        },
        "./decorator": {
            "types": "./dist/decorator/index.d.ts",
            "import": "./dist/decorator/index.js",
            "require": "./dist/decorator/index.cjs"
        },
        "./fluent": {
            "types": "./dist/fluent/index.d.ts",
            "import": "./dist/fluent/index.js",
            "require": "./dist/fluent/index.cjs"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "keywords": [
        "code-generation",
        "framework",
        "openws",
        "polytric",
        "realtime",
        "schema",
        "sdk",
        "websocket",
        "ws"
    ],
    "author": "Polytric",
    "license": "Apache-2.0",
    "scripts": {
        "build": "tsup",
        "build:watch": "tsup --watch src",
        "prepublishOnly": "pnpm build",
        "setup": "pnpm install",
        "test:create-peer:ts": "tsx test/runtime-create-peer.ts",
        "test:class:cjs": "nodemon -w dist -w test/class.cjs test/class.cjs",
        "test:class-lifecycle:ts": "tsx test/class-lifecycle.ts",
        "test:class:ts": "tsx watch test/class.ts",
        "test:decorator:cjs": "nodemon -w dist -w test/decorator.cjs --exec 'esbuild test/decorator.cjs --bundle --platform=node --target=node18 --format=cjs --packages=external | node'",
        "test:decorator:ts": "tsx watch test/decorator.ts",
        "test:fluent:cjs": "nodemon -w dist -w test/fluent.cjs test/fluent.cjs",
        "test:fluent:ts": "tsx watch test/fluent.ts"
    },
    "dependencies": {
        "@polytric/openws-spec": "workspace:^",
        "ajv": "^8.17.1"
    },
    "devDependencies": {
        "@pocketgems/schema": "^0.1.3",
        "@types/node": "^22.19.3",
        "esbuild": "^0.24.2",
        "nodemon": "^3.1.11",
        "tsup": "^8.5.1",
        "tsx": "^4.19.2"
    },
    "packageManager": "pnpm@10.26.1",
    "publishConfig": {
        "access": "public"
    }
}
