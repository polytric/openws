{
  "name": "@polytric/fastify-openws",
  "version": "0.0.2",
  "description": "Polytric OpenWS Runtime for Fastify",
  "main": "./src/index.js",
  "scripts": {
    "run:server": "nodemon -w src/index.js -w examples/server.js examples/server.js",
    "run:client-a": "nodemon -w src/index.js -w examples/client-a.js examples/client-a.js",
    "run:client-b": "nodemon -w src/index.js -w examples/client-b.js examples/client-b.js",
    "run:portal": "nodemon -w src/index.js -w examples/portal.js examples/portal.js",
    "setup": "pnpm install"
  },
  "keywords": [
    "websocket",
    "openws",
    "runtime",
    "fastify",
    "ws",
    "polytric",
    "schema",
    "realtime"
  ],
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "author": "Polytric",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.26.1",
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@polytric/openws-spec": "workspace:*",
    "ajv": "^8.17.1",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@pocketgems/schema": "^0.1.3",
    "fastify": "^5.6.2",
    "nodemon": "^3.1.11",
    "ws": "^8.18.3"
  }
}
