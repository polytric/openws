{
    "name": "@polytric/fastify-openws",
    "version": "0.0.9",
    "description": "Polytric OpenWS Runtime for Fastify",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "keywords": [
        "fastify",
        "openws",
        "polytric",
        "realtime",
        "runtime",
        "schema",
        "websocket",
        "ws"
    ],
    "author": "Polytric",
    "license": "Apache-2.0",
    "scripts": {
        "build": "tsup",
        "build:watch": "tsup --watch",
        "prepublishOnly": "pnpm build",
        "run:client-a": "nodemon -w src/index.cjs -w examples/client-a.cjs examples/client-a.cjs",
        "run:client-b": "nodemon -w src/index.cjs -w examples/client-b.cjs examples/client-b.cjs",
        "run:portal": "nodemon -w src/index.cjs -w examples/portal.cjs examples/portal.cjs",
        "run:server": "tsx watch examples/server.ts",
        "setup": "pnpm install",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fastify/websocket": "^11.2.0",
        "@polytric/openws": "workspace:^",
        "@polytric/openws-spec": "workspace:^",
        "ajv": "^8.17.1",
        "fastify-plugin": "^5.1.0"
    },
    "peerDependencies": {
        "fastify": "^5.6.2"
    },
    "devDependencies": {
        "@pocketgems/schema": "^0.1.3",
        "@types/ws": "^8.5.13",
        "nodemon": "^3.1.11",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "ws": "^8.18.3"
    },
    "packageManager": "pnpm@10.26.1",
    "publishConfig": {
        "access": "public"
    }
}
