{
    "name": "@polytric/fastify-openws-ui",
    "version": "0.0.6",
    "description": "Polytric OpenWS UI plugin for Fastify",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "keywords": [
        "code-generation",
        "fastify",
        "openws",
        "schema",
        "specification",
        "websocket"
    ],
    "author": "Polytric",
    "license": "Apache-2.0",
    "scripts": {
        "build": "tsup",
        "prepublishOnly": "pnpm build",
        "test:schema": "node test/validate-schema.js && echo valid",
        "typecheck": "tsc --noEmit",
        "watch:server": "tsx --watch test/server.ts"
    },
    "dependencies": {
        "@fastify/static": "^9.0.0",
        "@fastify/swagger-ui": "^5.2.4",
        "@fastify/websocket": "^11.2.0",
        "@polytric/fastify-openws": "workspace:^",
        "@polytric/openws-spec": "workspace:^",
        "@polytric/openws-ui": "workspace:^",
        "fastify-plugin": "^5.1.0"
    },
    "peerDependencies": {
        "fastify": "^5.6.2"
    },
    "devDependencies": {
        "@fastify/swagger": "^9.0.0",
        "@pocketgems/schema": "^0.1.3",
        "@polytric/openws": "workspace:^",
        "@types/node": "^22.19.3",
        "nodemon": "^3.1.11",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@10.26.1",
    "publishConfig": {
        "access": "public"
    }
}
