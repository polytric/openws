{
    "name": "@polytric/fastify-openws-ui",
    "version": "0.0.1",
    "description": "Polytric OpenWS specification plugin for Fastify",
    "main": "./dist/index.js",
    "type": "module",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsup",
        "prepublishOnly": "pnpm build",
        "watch:server": "tsx --watch test/server.ts",
        "test:schema": "node test/validate-schema.js && echo valid",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "websocket",
        "openws",
        "specification",
        "schema",
        "code-generation"
    ],
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "author": "Polytric",
    "license": "Apache-2.0",
    "packageManager": "pnpm@10.26.1",
    "dependencies": {
        "@fastify/static": "^9.0.0",
        "@fastify/websocket": "^11.2.0",
        "@polytric/fastify-openws": "workspace:*",
        "@polytric/openws-spec": "workspace:*",
        "@polytric/openws-ui": "workspace:*",
        "fastify-plugin": "^5.1.0"
    },
    "peerDependencies": {
        "fastify": "^5.6.2"
    },
    "devDependencies": {
        "@pocketgems/schema": "^0.1.3",
        "@polytric/openws": "workspace:*",
        "nodemon": "^3.1.11",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
