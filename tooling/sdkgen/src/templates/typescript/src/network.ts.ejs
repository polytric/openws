        if (socket) {
            this.bindSocket(socket)
        }
    }

    async connect(_roleName, endpoint) {
        if (!this.socket) {
            if (!endpoint) {
                throw new Error('Cannot connect without a WebSocket endpoint')
            }
            this.bindSocket(createWebSocket(endpoint))
        }
        await this.waitForOpen()
    }

    async disconnect() {
