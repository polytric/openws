## Usage

```csharp
using Polytric.OpenWs.Core;
using Polytric.OpenWs.Spec.Serialization.Serializer;
using Polytric.OpenWs.Unity;
using UnityEngine;
using <%= ctx.network.namespace %>;
using <%= ctx.network.namespace %>.Roles;
<% for (const modelNamespace of ctx.network.exampleModelNamespaces) { -%>
using <%= modelNamespace %>;
<% } -%>

class <%= ctx.network.behaviourClassName %> : MonoBehaviour, ISessionFactory
{
    async void Start()
    {
        var runtime = new Runtime(new <%= ctx.network.networkClassName %>(), new NewtonSoftSerializer(), this);
        var <%= ctx.network.hostRole.varName %> = runtime.GetHostRole<<%= ctx.network.hostRole.className %>>();
<% if (ctx.network.remoteRole.endpoints.length > 0) { -%>
        var <%= ctx.network.remoteRole.varName %> = await runtime.ConnectAsync<<%= ctx.network.remoteRole.className %>>(<%= ctx.network.remoteRole.className %>.Endpoints[0]);
<% } else { -%>
        var <%= ctx.network.remoteRole.varName %> = await runtime.ConnectAsync<<%= ctx.network.remoteRole.className %>>(new Endpoint { Scheme = "ws", Host = "localhost", Port = 8080, Path = "/" });
<% } -%>
<% if (ctx.network.sendExample) { -%>

        // Send a message to the <%= ctx.network.remoteRole.name %> role.
        <%= ctx.network.remoteRole.varName %>.<%= ctx.network.sendExample.methodName %>(<%= ctx.network.hostRole.varName %>.Name, new <%= ctx.network.sendExample.payloadClassName %> { /* ... */ });
<% } -%>
<% if (ctx.network.receiveExample) { -%>

        // React to messages addressed to the <%= ctx.network.hostRole.name %> role.
        <%= ctx.network.hostRole.varName %>.On<%= ctx.network.receiveExample.methodName %> += payload => { /* ... */ };
<% } -%>
    }

    public ISession CreateSession() => new NativeWebSocketSession();
}
