using Polytric.OpenWsSdk.Core;

namespace <%= ctx.namespace %> {
    public static class Endpoints {
        <% for (const endpoint of ctx.endpoints) { %>
        public static Endpoint[] <%= ctx.propertyName %> = new Endpoint[] { 
            <% for (const ep of endpoint.endpoints) { %>new Endpoint("<%= ep.host %>", <%= ep.port %>, "<%= ep.path %>"),<% } %>
        };
        <% } %>
    }
}