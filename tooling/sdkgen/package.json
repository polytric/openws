{
    "name": "@polytric/openws-sdkgen",
    "version": "0.0.3",
    "description": "OpenWS SDK generator CLI",
    "type": "module",
    "bin": {
        "openws-sdkgen": "./dist/main.cjs"
    },
    "files": [
        "dist",
        "src/dotnet/template",
        "LICENSE",
        "README.md"
    ],
    "keywords": [
        "openws",
        "sdk",
        "codegen",
        "websocket",
        "unity",
        "dotnet"
    ],
    "author": "Polytric",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AgeOfLearning/openws.git",
        "directory": "tooling/sdkgen"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "prepublishOnly": "pnpm build",
        "typecheck": "tsc --noEmit",
        "generate": "tsx src/main.ts",
        "test:csharp:unity": "tsx src/main.ts --spec ./test/spec.json --out ./generated/dotnet/unity --project Example --hostRole client --language csharp --environment unity"
    },
    "dependencies": {
        "@pocketgems/schema": "^0.1.3",
        "ejs": "^3.1.10",
        "yargs": "^18.0.0"
    },
    "devDependencies": {
        "@types/ejs": "^3.1.5",
        "@types/node": "^22.15.29",
        "@types/yargs": "^17.0.33",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@10.26.1"
}
